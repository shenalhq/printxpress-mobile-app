<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="16dp"
    android:background="@drawable/bg_card"
    android:orientation="vertical"
    android:padding="16dp">

    <ImageView
        android:id="@+id/designImage"
        android:layout_width="match_parent"
        android:layout_height="200dp"
        android:layout_marginBottom="12dp"
        android:background="@drawable/bg_card_soft_blue"
        android:scaleType="centerInside"
        android:src="@drawable/ic_logo"
        android:contentDescription="@string/design_preview" />

    <TextView
        android:id="@+id/designName"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="@color/px_text"
        android:textSize="18sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/designNotes"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:textColor="@color/px_text_secondary"
        android:textSize="14sp" />

    <TextView
        android:id="@+id/designDate"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:textColor="@color/px_text_secondary"
        android:textSize="12sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:orientation="horizontal">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/useDesignButton"
            style="@style/Widget.MaterialComponents.Button.TextButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/use_design" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/deleteDesignButton"
            style="@style/Widget.MaterialComponents.Button.TextButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:text="Delete"
            android:textColor="@color/px_danger" />
    </LinearLayout>
</LinearLayout>
