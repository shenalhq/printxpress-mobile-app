<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/px_background"
    android:orientation="vertical">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="18dp" android:paddingEnd="18dp"
            android:paddingBottom="18dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingTop="8dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="PrintXpress"
                        android:textColor="@color/px_text_secondary"
                        android:textSize="13sp" />

                    <TextView
                        android:id="@+id/greetingText"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="3dp"
                        android:text="Hello"
                        android:textColor="@color/px_text"
                        android:textSize="26sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="3dp"
                        android:text="Create quality prints in a few simple steps."
                        android:textColor="@color/px_text_secondary" />
                </LinearLayout>

                <FrameLayout
                    android:id="@+id/notificationContainer"
                    android:layout_width="46dp"
                    android:layout_height="46dp"
                    android:layout_marginEnd="10dp"
                    android:background="@drawable/bg_circle_button"
                    android:clickable="true"
                    android:focusable="true"
                    android:foreground="?attr/selectableItemBackgroundBorderless">

                    <ImageView
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:layout_gravity="center"
                        android:src="@drawable/ic_nav_bell" />

                    <TextView
                        android:id="@+id/notificationBadge"
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:layout_gravity="top|end"
                        android:background="@drawable/bg_badge"
                        android:gravity="center"
                        android:text="0"
                        android:textColor="@android:color/white"
                        android:textSize="10sp"
                        android:textStyle="bold"
                        android:visibility="gone" />
                </FrameLayout>

                <FrameLayout
                    android:id="@+id/profileTopButton"
                    android:layout_width="46dp"
                    android:layout_height="46dp"
                    android:background="@drawable/bg_circle_button"
                    android:clickable="true"
                    android:focusable="true"
                    android:foreground="?attr/selectableItemBackgroundBorderless">

                    <ImageView
                        android:id="@+id/topProfileImage"
                        android:layout_width="38dp"
                        android:layout_height="38dp"
                        android:layout_gravity="center"
                        android:background="@drawable/bg_circle_primary_soft"
                        android:clipToOutline="true"
                        android:padding="8dp"
                        android:scaleType="centerCrop"
                        android:src="@drawable/ic_nav_profile" />
                </FrameLayout>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/searchBox"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="18dp"
                android:background="@drawable/bg_search_bar"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackground"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="16dp" android:paddingEnd="16dp">

                <ImageView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:src="@drawable/ic_nav_search" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:layout_weight="1"
                    android:text="Search products, materials or services"
                    android:textColor="@color/px_text_secondary"
                    android:textSize="14sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_chip"
                    android:paddingStart="12dp" android:paddingEnd="12dp"
                    android:paddingTop="7dp" android:paddingBottom="7dp"
                    android:text="Search"
                    android:textColor="@color/px_primary"
                    android:textStyle="bold" />
            </LinearLayout>

            <FrameLayout
                android:id="@+id/promoCard"
                android:layout_width="match_parent"
                android:layout_height="190dp"
                android:layout_marginTop="18dp"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackground">

                <ImageView
                    android:id="@+id/promoImage"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@drawable/bg_card"
                    android:clipToOutline="true"
                    android:contentDescription="Current offer"
                    android:scaleType="centerCrop"
                    android:src="@drawable/promo_business_pack" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@drawable/bg_promo_overlay" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="vertical"
                    android:padding="18dp">

                    <TextView
                        android:id="@+id/promoEyebrow"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="LIMITED OFFER"
                        android:textAllCaps="true"
                        android:textColor="#7ED3FF"
                        android:textSize="11sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/promoTitle"
                        android:layout_width="250dp"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="5dp"
                        android:text="Business Essentials"
                        android:textColor="@android:color/white"
                        android:textSize="23sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/promoDescription"
                        android:layout_width="245dp"
                        android:layout_height="0dp"
                        android:layout_marginTop="5dp"
                        android:layout_weight="1"
                        android:text="Save on cards and flyers for your next brand launch."
                        android:textColor="#E8EEF8"
                        android:textSize="13sp" />

                    <TextView
                        android:id="@+id/promoCta"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_offer_button"
                        android:paddingStart="14dp" android:paddingEnd="14dp"
                        android:paddingTop="8dp" android:paddingBottom="8dp"
                        android:text="SHOP OFFER  →"
                        android:textColor="#102544"
                        android:textSize="12sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/promoDots"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="bottom|center_horizontal"
                    android:layout_marginBottom="10dp"
                    android:gravity="center"
                    android:orientation="horizontal">

                    <View
                        android:id="@+id/promoDot1"
                        android:layout_width="22dp"
                        android:layout_height="6dp"
                        android:background="@drawable/bg_promo_dot_active" />

                    <View
                        android:id="@+id/promoDot2"
                        android:layout_width="7dp"
                        android:layout_height="7dp"
                        android:layout_marginStart="6dp"
                        android:background="@drawable/bg_promo_dot_inactive" />

                    <View
                        android:id="@+id/promoDot3"
                        android:layout_width="7dp"
                        android:layout_height="7dp"
                        android:layout_marginStart="6dp"
                        android:background="@drawable/bg_promo_dot_inactive" />
                </LinearLayout>
            </FrameLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="22dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Popular print products"
                    android:textColor="@color/px_text"
                    android:textSize="20sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/seeAllProducts"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:clickable="true"
                    android:focusable="true"
                    android:padding="8dp"
                    android:text="See all"
                    android:textColor="@color/px_primary"
                    android:textStyle="bold" />
            </LinearLayout>

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/productList"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:nestedScrollingEnabled="false" />
        </LinearLayout>
    </ScrollView>

    <include layout="@layout/view_bottom_dock" />
</LinearLayout>
